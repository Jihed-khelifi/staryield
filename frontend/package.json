{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:calculators": "node scripts/check-calculators.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy": "npm run deploy:vinext",
    "cf:typegen": "wrangler types",
    "assets:upload": "node scripts/upload-r2-images.mjs",
    "test:r2": "node scripts/check-r2-images.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.13",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "negotiator": "^1.1.0",
    "next": "16.3.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@tailwindcss/postcss": "^4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.1",
    "vite": "^8.3.2",
    "wrangler": "^4.146.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
