{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staryield",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "account_id": "16c440d01a18bd18b68ac9ca44940bea",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "staryield.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
