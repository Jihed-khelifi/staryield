# Staryield API configuration: environment variables only.
#
# Local development: copy this file to .env (`cp .env.example .env`). The api,
# migrate and seed commands load ./.env at startup (or the file given with
# -env-file) without overriding variables already set in the environment.
# Railway and other hosts: set the same names as service variables; no file is
# needed or read.
#
# Every setting is STARYIELD_<SECTION>_<KEY>. Commented lines below show the
# built-in default. Durations use Go syntax (500ms, 30s, 15m, 2h); lists are
# comma-separated; quote values that contain spaces. DATABASE_URL, REDIS_URL,
# APP_ENV and PORT are used when the STARYIELD_* equivalent is unset. Unknown
# STARYIELD_* names are reported in the startup log.
#
# Production (STARYIELD_APP_ENV=production, the default on Railway) refuses to
# start until every setting marked "required in production" is valid.

# -----------------------------------------------------------------------------
# Local development values. Never use them outside your machine.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/staryield?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
STARYIELD_LOG_FORMAT=console

# With the in-memory storage driver, uploaded images are served by the API
# itself so they display locally.
STARYIELD_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/_dev/storage/avatars
R2_ADVISOR_IMAGE_PUBLIC_URL=http://localhost:8080/_dev/storage/advisors

# Accounts created by `make seed` (advisors log in as
# <slug>@advisors.staryield.net). Read by the seed command only.
STARYIELD_SEED_ADMIN_EMAIL=admin@staryield.test
STARYIELD_SEED_ADMIN_PASSWORD=Adm1n!Secure#2026
STARYIELD_SEED_PSYCHIC_PASSWORD=Psych1c!Secure#2026
STARYIELD_SEED_CLIENT_EMAIL=client@staryield.test
STARYIELD_SEED_CLIENT_PASSWORD=Cl1ent!Secure#2026
STARYIELD_SEED_CLIENT_CREDITS=500

# -----------------------------------------------------------------------------
# Reference: every setting and its default.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
# STARYIELD_APP_ENV=development              # development | test | production (alias APP_ENV)
# STARYIELD_APP_NAME=staryield-api
# STARYIELD_APP_FRONTEND_URL=http://localhost:3000   # https://staryield.net in production
# STARYIELD_APP_INSTANCE_ID=                 # alias RAILWAY_REPLICA_ID; defaults to host-pid

# --- HTTP --------------------------------------------------------------------
# STARYIELD_HTTP_ADDR=:8080                  # PORT=<n> sets :<n> when this is unset
# STARYIELD_HTTP_READ_HEADER_TIMEOUT=5s
# STARYIELD_HTTP_READ_TIMEOUT=30s
# STARYIELD_HTTP_WRITE_TIMEOUT=0s            # streaming endpoints manage their own deadlines
# STARYIELD_HTTP_IDLE_TIMEOUT=2m
# STARYIELD_HTTP_REQUEST_TIMEOUT=15s         # deadline cascaded to every DB/Redis call
# STARYIELD_HTTP_SHUTDOWN_TIMEOUT=20s
# STARYIELD_HTTP_BODY_LIMIT=64KB
# STARYIELD_HTTP_IP_SOURCE=direct            # direct | xff | x-real-ip | cloudflare (x-real-ip on Railway)
# STARYIELD_HTTP_TRUSTED_PROXIES=            # CIDRs whose proxy headers are trusted (Railway private ranges on Railway)

# --- Database (PostgreSQL) ---------------------------------------------------
# STARYIELD_DATABASE_DSN=postgres://postgres@127.0.0.1:5432/staryield?sslmode=disable   # alias DATABASE_URL
# STARYIELD_DATABASE_MAX_OPEN_CONNS=25
# STARYIELD_DATABASE_MAX_IDLE_CONNS=10
# STARYIELD_DATABASE_CONN_MAX_LIFETIME=30m
# STARYIELD_DATABASE_CONN_MAX_IDLE_TIME=5m
# STARYIELD_DATABASE_SLOW_QUERY=250ms
# STARYIELD_DATABASE_AUTO_MIGRATE=true       # migrations run at startup under an advisory lock
# STARYIELD_DATABASE_CONNECT_TIMEOUT=1m      # startup retries while the database boots

# --- Redis -------------------------------------------------------------------
# STARYIELD_REDIS_URL=redis://127.0.0.1:6379/0   # alias REDIS_URL
# STARYIELD_REDIS_DIAL_TIMEOUT=3s
# STARYIELD_REDIS_READ_TIMEOUT=3s
# STARYIELD_REDIS_WRITE_TIMEOUT=3s
# STARYIELD_REDIS_POOL_SIZE=50
# STARYIELD_REDIS_KEY_PREFIX=sy:
# STARYIELD_REDIS_CONNECT_TIMEOUT=1m

# --- Auth --------------------------------------------------------------------
# STARYIELD_AUTH_JWT_SECRET=                 # required in production, >= 32 bytes (openssl rand -hex 48)
# STARYIELD_AUTH_JWT_ISSUER=staryield-api
# STARYIELD_AUTH_JWT_AUDIENCE=staryield-web
# STARYIELD_AUTH_ACCESS_TOKEN_TTL=15m
# STARYIELD_AUTH_REFRESH_TOKEN_TTL=720h
# STARYIELD_AUTH_PASSWORD_RESET_TTL=30m
# STARYIELD_AUTH_ARGON2_MEMORY_KIB=65536
# STARYIELD_AUTH_ARGON2_ITERATIONS=3
# STARYIELD_AUTH_ARGON2_PARALLELISM=2
# STARYIELD_AUTH_LOGIN_MAX_FAILURES=5
# STARYIELD_AUTH_LOGIN_LOCKOUT=15m
# STARYIELD_AUTH_MINIMUM_AGE=18
# STARYIELD_AUTH_USER_STATUS_CACHE_TTL=30s

# --- Security ----------------------------------------------------------------
# STARYIELD_SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001   # https://staryield.net in production
# STARYIELD_SECURITY_ADMIN_ORIGINS=http://localhost:3002   # the only origin allowed on /api/v1/admin/** (https://admin.staryield.net)
# STARYIELD_SECURITY_ADMIN_IP_ALLOWLIST=     # optional CIDRs for admin routes, e.g. 203.0.113.0/24
# STARYIELD_SECURITY_DATA_ENCRYPTION_KEY=    # required in production: 32 bytes hex/base64 (openssl rand -hex 32); encrypts TOTP secrets and payout details
# STARYIELD_SECURITY_CSRF_SECRET=            # required in production, >= 32 bytes
# STARYIELD_SECURITY_COOKIE_DOMAIN=          # e.g. .staryield.net when the API lives on api.staryield.net
# STARYIELD_SECURITY_COOKIE_SECURE=false     # must be true in production (default on Railway)
# STARYIELD_SECURITY_HSTS=false              # true on Railway

# --- Admin console -----------------------------------------------------------
# STARYIELD_ADMIN_SESSION_TTL=8h             # absolute session lifetime (<= 24h)
# STARYIELD_ADMIN_IDLE_TIMEOUT=30m           # sliding inactivity timeout
# STARYIELD_ADMIN_STEP_UP_WINDOW=10m         # sensitive actions need a TOTP code verified this recently
# STARYIELD_ADMIN_CHALLENGE_TTL=5m           # time to enter the TOTP code after the password
# STARYIELD_ADMIN_TOTP_ISSUER="Staryield Admin"

# --- Live chat ---------------------------------------------------------------
# STARYIELD_CHAT_REQUEST_TIMEOUT=90s         # unanswered requests expire
# STARYIELD_CHAT_ACCEPTED_TIMEOUT=2m         # accepted but both parties never connected
# STARYIELD_CHAT_GRACE_PERIOD=90s            # reconnection window
# STARYIELD_CHAT_BILLING_INTERVAL=1m         # one billed (started) minute
# STARYIELD_CHAT_MAX_MESSAGE_LENGTH=1000
# STARYIELD_CHAT_HISTORY_PAGE_SIZE=50
# STARYIELD_CHAT_LOW_BALANCE_MINUTES=2
# STARYIELD_CHAT_MESSAGE_RATE=20             # messages per STARYIELD_CHAT_MESSAGE_RATE_EVERY
# STARYIELD_CHAT_MESSAGE_RATE_EVERY=10s

# --- Billing -----------------------------------------------------------------
# STARYIELD_BILLING_PSYCHIC_SHARE_PERCENT=60 # advisor share of gross credits
# STARYIELD_BILLING_SIGNUP_FREE_MINUTES=3
# STARYIELD_BILLING_SIGNUP_BONUS_CREDITS=0
# STARYIELD_BILLING_MAX_ADMIN_ADJUSTMENT=100000
# STARYIELD_BILLING_PAYOUT_CENTS_PER_CREDIT=2   # value of one earned credit at withdrawal
# STARYIELD_BILLING_MIN_WITHDRAWAL_CREDITS=2500

# --- Custom requests ---------------------------------------------------------
# STARYIELD_CUSTOM_REQUESTS_ACCEPT_TIMEOUT=48h
# STARYIELD_CUSTOM_REQUESTS_DELIVERY_TIMEOUT=168h
# STARYIELD_CUSTOM_REQUESTS_DISPUTE_WINDOW=336h
# STARYIELD_CUSTOM_REQUESTS_MAX_NOTE_LENGTH=2000
# STARYIELD_CUSTOM_REQUESTS_MAX_DELIVERY_LENGTH=10000

# --- Realtime (WebSocket / SSE) ----------------------------------------------
# STARYIELD_REALTIME_PING_INTERVAL=25s       # must be shorter than the pong wait
# STARYIELD_REALTIME_PONG_WAIT=1m
# STARYIELD_REALTIME_WRITE_WAIT=10s
# STARYIELD_REALTIME_MAX_FRAME_BYTES=16384
# STARYIELD_REALTIME_SEND_BUFFER=256
# STARYIELD_REALTIME_TICKET_TTL=30s
# STARYIELD_REALTIME_STREAM_MAX_LEN=500
# STARYIELD_REALTIME_STREAM_TTL=24h
# STARYIELD_REALTIME_REPLAY_LIMIT=500
# STARYIELD_REALTIME_MAX_CONNS_PER_USER=6
# STARYIELD_REALTIME_PRESENCE_TTL=45s
# STARYIELD_REALTIME_FRAME_RATE=10
# STARYIELD_REALTIME_FRAME_BURST=30
# STARYIELD_REALTIME_TYPING_MIN_INTERVAL=1500ms

# --- Rate limits (token buckets: RATE per PERIOD, up to BURST) ---------------
# STARYIELD_RATE_LIMIT_ENABLED=true
# STARYIELD_RATE_LIMIT_FAIL_OPEN=true        # auth rules always fail closed
# STARYIELD_RATE_LIMIT_SCALE=1               # multiplies every rate (load tests)
# STARYIELD_RATE_LIMIT_GLOBAL_RATE=300
# STARYIELD_RATE_LIMIT_GLOBAL_PERIOD=1m
# STARYIELD_RATE_LIMIT_GLOBAL_BURST=120
# STARYIELD_RATE_LIMIT_AUTH_RATE=10
# STARYIELD_RATE_LIMIT_AUTH_PERIOD=1m
# STARYIELD_RATE_LIMIT_AUTH_BURST=10
# STARYIELD_RATE_LIMIT_WRITES_RATE=60
# STARYIELD_RATE_LIMIT_WRITES_PERIOD=1m
# STARYIELD_RATE_LIMIT_WRITES_BURST=30
# STARYIELD_RATE_LIMIT_INGEST_RATE=120
# STARYIELD_RATE_LIMIT_INGEST_PERIOD=1m
# STARYIELD_RATE_LIMIT_INGEST_BURST=60
# STARYIELD_RATE_LIMIT_UPLOAD_RATE=10
# STARYIELD_RATE_LIMIT_UPLOAD_PERIOD=1h
# STARYIELD_RATE_LIMIT_UPLOAD_BURST=5

# --- Storage (Cloudflare R2) -------------------------------------------------
# STARYIELD_STORAGE_DRIVER=memory            # r2 | memory | disabled (memory is refused in production)
# STARYIELD_STORAGE_R2_ACCOUNT_ID=           # or STARYIELD_STORAGE_R2_ENDPOINT
# STARYIELD_STORAGE_R2_ENDPOINT=
# STARYIELD_STORAGE_R2_ACCESS_KEY_ID=
# STARYIELD_STORAGE_R2_SECRET_ACCESS_KEY=
# STARYIELD_STORAGE_R2_BUCKET=staryield-app-assets
# STARYIELD_STORAGE_PUBLIC_BASE_URL=https://assets.staryield.net
# STARYIELD_STORAGE_MAX_AVATAR_BYTES=1048576
# STARYIELD_STORAGE_MAX_AVATAR_PIXELS=16777216
# STARYIELD_STORAGE_AVATAR_SIZE=256
# STARYIELD_STORAGE_ADVISOR_BUCKET=          # alias R2_ADVISOR_IMAGE: public advisor portraits
# STARYIELD_STORAGE_ADVISOR_PUBLIC_BASE_URL=https://advisors.staryield.net   # alias R2_ADVISOR_IMAGE_PUBLIC_URL
# STARYIELD_STORAGE_MAX_ADVISOR_IMAGE_BYTES=5242880
# STARYIELD_STORAGE_ADVISOR_IMAGE_MAX_SIDE=1200
# STARYIELD_STORAGE_CHAT_BUCKET=             # alias R2_CHAT_IMAGES_PRIVATE: private chat images, never public
# STARYIELD_STORAGE_MAX_CHAT_IMAGE_BYTES=8388608
# STARYIELD_STORAGE_CHAT_IMAGE_MAX_SIDE=2048
# STARYIELD_STORAGE_MAX_IMAGE_PIXELS=40000000   # decompression-bomb bound
# R2_ADVISOR_IMAGE=staryield-advisor-images
# R2_CHAT_IMAGES_PRIVATE=staryield-chat-images-private

# --- Payments ----------------------------------------------------------------
# STARYIELD_PAYMENTS_PROVIDER=sandbox        # sandbox | disabled (sandbox is refused in production)
# STARYIELD_PAYMENTS_WEBHOOK_SECRET=         # required in production, >= 16 bytes
# STARYIELD_PAYMENTS_WEBHOOK_TOLERANCE=5m
# STARYIELD_PAYMENTS_ALLOW_SANDBOX_IN_PRODUCTION=false
# STARYIELD_PAYMENTS_CURRENCY=USD

# --- Analytics ---------------------------------------------------------------
# STARYIELD_ANALYTICS_ENABLED=true
# STARYIELD_ANALYTICS_IP_HASH_SECRET=        # required in production, >= 16 bytes
# STARYIELD_ANALYTICS_BUFFER_SIZE=10000
# STARYIELD_ANALYTICS_BATCH_SIZE=200
# STARYIELD_ANALYTICS_FLUSH_INTERVAL=2s
# STARYIELD_ANALYTICS_MAX_CLIENT_BATCH=50

# --- Logging -----------------------------------------------------------------
# STARYIELD_LOG_LEVEL=info                   # debug | info | warn | error
# STARYIELD_LOG_FORMAT=json                  # json | console

# --- Mail --------------------------------------------------------------------
# STARYIELD_MAIL_DRIVER=log                  # log (development only) | noop
# STARYIELD_MAIL_FROM="Staryield <no-reply@staryield.net>"

# --- Background workers ------------------------------------------------------
# STARYIELD_WORKER_ENABLED=true
# STARYIELD_WORKER_TICK_INTERVAL=1s
# STARYIELD_WORKER_PRESENCE_SWEEP=5s
# STARYIELD_WORKER_MAINTENANCE_TICK=30s
# STARYIELD_WORKER_BATCH_SIZE=100

# --- Marketing links ---------------------------------------------------------
# STARYIELD_LINKS_PUBLIC_BASE_URL=http://localhost:3000/go   # https://staryield.net/go in production
# STARYIELD_LINKS_ALLOWED_HOSTS=             # extra hosts allowed as absolute link destinations

# --- Reviews -----------------------------------------------------------------
# STARYIELD_REVIEWS_WINDOW=168h              # clients can rate a reading up to 7 days after it ends

# --- Notifications -----------------------------------------------------------
# STARYIELD_NOTIFICATIONS_BUFFER_SIZE=10000  # async queue; overflow is dropped, never blocking requests
# STARYIELD_NOTIFICATIONS_BATCH_SIZE=200
# STARYIELD_NOTIFICATIONS_FLUSH_INTERVAL=250ms
